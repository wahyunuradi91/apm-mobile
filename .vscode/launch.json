{
  "version": "0.2.0",
  "configurations": [
    {
      // Perangkat dipilih dari status bar VS Code (pojok kanan bawah) — pilih HP Android.
      "name": "APM (HP Android / perangkat terpilih)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=env/dev.json"]
    },
    {
      "name": "APM (emulator)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "emulator-5554",
      "args": ["--dart-define-from-file=env/dev.json"]
    }
  ]
}
